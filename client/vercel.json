{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://deployai-api-production.up.railway.app/api/:path*"
    },
    {
      "source": "/hubs/:path*",
      "destination": "https://deployai-api-production.up.railway.app/hubs/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm install"
}