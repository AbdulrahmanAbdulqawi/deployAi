{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ng", "serve", "--proxy-config", "proxy.conf.local.json"],
      "cwd": "client",
      "port": 4200,
      "autoPort": false
    },
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--no-build"],
      "cwd": "src/DeployAI.Api",
      "port": 5080,
      "autoPort": false
    }
  ]
}
