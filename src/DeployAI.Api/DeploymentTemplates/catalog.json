      "scenarioId": "split-origin.angular.vercel.dotnet.railway",
      "fileName": "app.config.ts",
      "kind": "patch",
      "resourcePath": "split-origin/angular-vercel-dotnet-railway/patches/app.config.ts.patch.md",
      "aiReference": { "includeInPrompt": true, "priority": 1 },
      "constraints": [
