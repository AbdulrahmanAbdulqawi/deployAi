      "aiReference": { "includeInPrompt": true, "priority": 1 },
      "constraints": [
        "Fail the build when API URL env vars are missing in CI/Vercel.",
        "Write apiBaseUrl into environment.production.ts at build time."
      ]
    },
    {
      "id": "split-origin.angular.vercel.railway.api-base-interceptor",
      "scenarioId": "split-origin.angular.vercel.dotnet.railway",
      "fileName": "api-base.interceptor.ts",
      "kind": "full-file",
      "resourcePath": "split-origin/angular-vercel-dotnet-railway/api-base.interceptor.ts.tpl",
      "aiReference": { "includeInPrompt": true, "priority": 1 },
      "constraints": [
        "Rewrite relative /api/* and /hubs/* requests to environment.apiBaseUrl.",
        "Adjust import path to match the repo's environments folder layout."
      ]
    },
    {
      "id": "split-origin.angular.vercel.railway.environment-ts",
      "scenarioId": "split-origin.angular.vercel.dotnet.railway",
      "fileName": "environment.ts",
      "kind": "full-file",
      "resourcePath": "split-origin/angular-vercel-dotnet-railway/environment.ts.tpl",
      "aiReference": { "includeInPrompt": true, "priority": 2 },
      "constraints": [
        "Use apiBaseUrl (not apiUrl alone) for split-origin wiring."
      ]
    },
    {
      "id": "split-origin.angular.vercel.railway.environment-production-ts",
      "scenarioId": "split-origin.angular.vercel.dotnet.railway",
      "fileName": "environment.production.ts",
      "kind": "full-file",
      "resourcePath": "split-origin/angular-vercel-dotnet-railway/environment.production.ts.tpl",
      "aiReference": { "includeInPrompt": true, "priority": 2 },
      "constraints": [
        "Production apiBaseUrl is injected by write-api-env.mjs at build time."
      ]
    },
    {
      "id": "split-origin.angular.vercel.railway.health-controller",
      "scenarioId": "split-origin.angular.vercel.dotnet.railway",
      "fileName": "HealthController.cs",
      "kind": "full-file",
      "resourcePath": "split-origin/angular-vercel-dotnet-railway/HealthController.cs.tpl",
      "aiReference": { "includeInPrompt": true, "priority": 2 },
      "constraints": [
        "Route must be api/v1/health for Railway health probes.",
        "Match existing controller namespace conventions."
      ]
    },
    {
      "id": "split-origin.angular.vercel.railway.deployment-md",
      "scenarioId": "split-origin.angular.vercel.dotnet.railway",
      "fileName": "DEPLOYMENT.md",
      "kind": "full-file",
      "resourcePath": "split-origin/angular-vercel-dotnet-railway/DEPLOYMENT.md.tpl",
