{
  "scenarios": [
    {
      "id": "split-origin.angular.vercel.dotnet.railway",
      "websiteProvider": "vercel",
      "backendProvider": "railway",
      "websiteFramework": "angular",
      "backendFramework": "dotnet",
      "wiringMode": "split-origin"
    }
  ],
  "templates": [
    {
      "id": "split-origin.angular.vercel.railway.railway-toml",
      "scenarioId": "split-origin.angular.vercel.dotnet.railway",
      "fileName": "railway.toml",
      "kind": "full-file",
      "resourcePath": "split-origin/angular-vercel-dotnet-railway/railway.toml.tpl",
      "aiReference": { "includeInPrompt": true, "priority": 1 },
      "constraints": [
        "Use dockerfilePath from the deployment plan server part.",
        "Do not add custom build commands unless the plan specifies them."
      ]
    },
    {
      "id": "split-origin.angular.vercel.railway.vercel-json",
      "scenarioId": "split-origin.angular.vercel.dotnet.railway",
      "fileName": "vercel.json",
      "kind": "full-file",
      "resourcePath": "split-origin/angular-vercel-dotnet-railway/vercel.json.tpl",
      "aiReference": { "includeInPrompt": true, "priority": 1 },
      "constraints": [
        "SPA-only rewrites to /index.html — never add /api or /hubs proxy rewrites on split-origin.",
        "buildCommand must run write-api-env.mjs before ng build when not already present."
      ]
    },
    {
      "id": "split-origin.angular.vercel.railway.write-api-env",
      "scenarioId": "split-origin.angular.vercel.dotnet.railway",
