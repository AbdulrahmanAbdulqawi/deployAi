      ]
    },
    {
      "id": "split-origin.angular.vercel.railway.auth-service",
      "scenarioId": "split-origin.angular.vercel.dotnet.railway",
      "fileName": "auth.service.ts",
      "kind": "patch",
      "resourcePath": "split-origin/angular-vercel-dotnet-railway/patches/auth.service.ts.patch.md",
      "aiReference": { "includeInPrompt": true, "priority": 2 },
      "constraints": [
        "Auth client path must be /api/v1/auth with withCredentials: true on login/refresh/logout."
      ]
    },
    {
      "id": "split-origin.angular.vercel.railway.signalr-service",
      "scenarioId": "split-origin.angular.vercel.dotnet.railway",
      "fileName": "signalr.service.ts",
      "kind": "patch",
      "resourcePath": "split-origin/angular-vercel-dotnet-railway/patches/signalr.service.ts.patch.md",
      "aiReference": { "includeInPrompt": true, "priority": 3 },
