      "scenarioId": "split-origin.angular.vercel.dotnet.railway",
      "fileName": "angular.json",
      "kind": "patch",
      "resourcePath": "split-origin/angular-vercel-dotnet-railway/patches/angular.json.patch.md",
      "aiReference": { "includeInPrompt": true, "priority": 1 },
