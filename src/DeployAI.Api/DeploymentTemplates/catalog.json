        "Read existing app.config.ts before editing."
      ]
    },
    {
      "id": "split-origin.angular.vercel.railway.program-cs",
      "scenarioId": "split-origin.angular.vercel.dotnet.railway",
      "fileName": "Program.cs",
      "kind": "patch",
      "resourcePath": "split-origin/angular-vercel-dotnet-railway/patches/Program.cs.patch.md",
      "aiReference": { "includeInPrompt": true, "priority": 1 },
      "constraints": [
        "Add CORS allowing *.vercel.app and AllowedOrigins configuration section.",
        "Insert CORS before var app = builder.Build(); preserve existing middleware order."
      ]
    },
    {
      "id": "split-origin.angular.vercel.railway.auth-controller",
      "scenarioId": "split-origin.angular.vercel.dotnet.railway",
      "fileName": "AuthController.cs",
      "kind": "patch",
      "resourcePath": "split-origin/angular-vercel-dotnet-railway/patches/AuthController.cs.patch.md",
      "aiReference": { "includeInPrompt": true, "priority": 2 },
      "constraints": [
